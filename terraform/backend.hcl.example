# Copy to terraform/backend.hcl (never commit backend.hcl)
# Authenticate using Linode Object Storage Access Keys via environment variables:
#   export AWS_ACCESS_KEY_ID="<linode-object-storage-access-key>"
#   export AWS_SECRET_ACCESS_KEY="<linode-object-storage-secret-key>"
#
# Initialize with:
#   terraform init -backend-config=backend.hcl

bucket = "rlg-terraform-state"
key    = "appitect-mini/shared-01/production/terraform.tfstate"

endpoints = {
  s3 = "https://us-east-1.linodeobjects.com"
}
